<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="org.yasvara.laras">

    <!-- Required by SystemUI to render its lock screen preview for Laras. -->
    <uses-permission android:name="android.permission.BIND_WALLPAPER" />
    <uses-permission android:name="android.permission.CUSTOMIZE_SYSTEM_UI" />
    <uses-permission android:name="android.permission.READ_WALLPAPER_INTERNAL" />
    <!-- Depth library: sets a saved picture as the wallpaper with its depth. -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- Depth build: a foreground service, started when SystemUI asks. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <uses-permission android:name="android.permission.START_FOREGROUND_SERVICES_FROM_BACKGROUND" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.CONFIGURE_DISPLAY_BRIGHTNESS" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="yasvara.permission.WRITE_ATTESTATION" />
    <!-- Kait: modules and per-user scope (YasvaraKait in system_server). -->
    <uses-permission android:name="yasvara.permission.MANAGE_KAIT" />
    <!-- App updates: per-app detach / delay / ask (YasvaraUpdatePolicyService). -->
    <uses-permission android:name="yasvara.permission.MANAGE_UPDATE_POLICY" />
    <uses-permission android:name="yasvara.permission.MANAGE_SWARA" />
    <!-- Akar: the native root's control plane (YasvaraRootService). Signature level
         (platform key): other platform apps may hold it, nothing else, and not by pm grant. -->
    <permission
        android:name="yasvara.permission.MANAGE_ROOT"
        android:protectionLevel="signature" />
    <uses-permission android:name="yasvara.permission.MANAGE_ROOT" />
    <!-- Ketik: Gboard flag overrides (YasvaraKetikService). Signature level. -->
    <permission
        android:name="yasvara.permission.MANAGE_KETIK"
        android:protectionLevel="signature" />
    <uses-permission android:name="yasvara.permission.MANAGE_KETIK" />
    <!-- Package visibility rules (YasvaraAppVisibilityService). Signature level. -->
    <permission
        android:name="yasvara.permission.MANAGE_APP_VISIBILITY"
        android:protectionLevel="signature" />
    <uses-permission android:name="yasvara.permission.MANAGE_APP_VISIBILITY" />
    <!-- App sleep and telemetry cuts (YasvaraLelapService). Signature level. -->
    <permission
        android:name="yasvara.permission.MANAGE_LELAP"
        android:protectionLevel="signature" />
    <uses-permission android:name="yasvara.permission.MANAGE_LELAP" />
    <!-- Name and browser filtering (YasvaraSaringService). Signature level. -->
    <permission
        android:name="yasvara.permission.MANAGE_SARING"
        android:protectionLevel="signature" />
    <uses-permission android:name="yasvara.permission.MANAGE_SARING" />
    <!-- Realtime per-app F2FS compression (PadatService). Signature level. -->
    <permission
        android:name="yasvara.permission.MANAGE_PADAT"
        android:protectionLevel="signature" />
    <uses-permission android:name="yasvara.permission.MANAGE_PADAT" />
    <!-- Pasang In-OS Live CoW OTA daemon (`yasvara.pasang`). Signature level. -->
    <permission
        android:name="yasvara.permission.MANAGE_PASANG"
        android:protectionLevel="signature" />
    <uses-permission android:name="yasvara.permission.MANAGE_PASANG" />
    <!-- Samar: the location apps see and location privacy (SamarService). Signature level. -->
    <permission
        android:name="yasvara.permission.MANAGE_SAMAR"
        android:protectionLevel="signature" />
    <uses-permission android:name="yasvara.permission.MANAGE_SAMAR" />
    <!-- Tempel: NFC card vault, profile switching, and tag writer (YasvaraTempelService). -->
    <permission
        android:name="yasvara.permission.MANAGE_TEMPEL"
        android:protectionLevel="signature" />
    <uses-permission android:name="yasvara.permission.MANAGE_TEMPEL" />
    <uses-permission android:name="android.permission.NFC" />
    <!-- Samar's floating map and joystick. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- MapLibre asks for these; Laras never reads location, it sets it. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Connectivity: hotspot width, allowed channels, network mode, signal bars,
         the serving cell card (ServiceState without location). -->
    <uses-permission android:name="android.permission.OVERRIDE_WIFI_CONFIG" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.MODIFY_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_PRIVILEGED_PHONE_STATE" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- The launcher's home screen preview and icon shapes. -->
    <uses-permission android:name="com.android.launcher3.permission.GRID_CONTROL" />

    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Laras">

        <activity
            android:name=".LarasActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode|assetsPaths"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="org.yasvara.laras.action.OPEN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Samar: the fake location page. -->
            <intent-filter>
                <action android:name="org.yasvara.laras.action.SAMAR" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Tempel: NFC card manager & writer. -->
            <intent-filter>
                <action android:name="org.yasvara.laras.action.TEMPEL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Long press on a Laras Quick Settings tile opens that tile's page. -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
            <!-- Settings › App info › Updates; extra "package". -->
            <intent-filter>
                <action android:name="org.yasvara.laras.action.APP_UPDATES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Notification of a refused root request; extra "package". -->
            <intent-filter>
                <action android:name="org.yasvara.laras.action.AKAR" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Kait: opens Kait module manager or a specific module's scope; extra "package". -->
            <intent-filter>
                <action android:name="org.yasvara.laras.action.KAIT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Nada: opens Processor effects directly. -->
            <intent-filter>
                <action android:name="org.yasvara.laras.action.NADA" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Volume Panel "Apps" › Manage. -->
            <intent-filter>
                <action android:name="org.yasvara.laras.action.SOUND_APPS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Settings › Hotspot › Speed › Wi-Fi region. -->
            <intent-filter>
                <action android:name="org.yasvara.laras.action.WIFI_REGION" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Settings › Storage › Padat F2FS compression; optional extra "package". -->
            <intent-filter>
                <action android:name="org.yasvara.laras.action.PADAT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Layang top-pill menu › Layang settings. -->
            <intent-filter>
                <action android:name="org.yasvara.laras.action.LAYANG" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Pasang: System Update (In-OS Live CoW OTA). -->
            <intent-filter>
                <action android:name="org.yasvara.laras.action.PASANG" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Settings homepage entry, placed first in the personalisation group. -->
            <intent-filter>
                <action android:name="com.android.settings.action.EXTRA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.homepage" />
            <meta-data
                android:name="com.android.settings.group_key"
                android:value="top_level_personalize_category" />
            <meta-data
                android:name="com.android.settings.keyhint"
                android:value="top_level_laras" />
            <meta-data
                android:name="com.android.settings.order"
                android:value="-70" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_laras" />
            <meta-data
                android:name="com.android.settings.icon_tintable"
                android:value="true" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/settings_entry_summary" />
        </activity>

        <!-- Standalone entry point for Homescreen pinned shortcuts and optional App Drawer icon. -->
        <activity
            android:name=".AkarActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode|assetsPaths"
            android:exported="true"
            android:icon="@mipmap/ic_akar_launcher"
            android:label="@string/akar_title"
            android:launchMode="singleTop"
            android:taskAffinity="org.yasvara.laras.akar"
            android:theme="@style/Theme.Laras" />
        <activity
            android:name=".AkarWebUiActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode|assetsPaths"
            android:exported="false"
            android:theme="@style/Theme.Laras" />
        <activity-alias
            android:name=".AkarLauncherAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_akar_launcher"
            android:label="@string/akar_title"
            android:targetActivity=".AkarActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Kait: standalone entry point for Homescreen pinned shortcuts and optional App Drawer icon. -->
        <activity
            android:name=".KaitActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode|assetsPaths"
            android:exported="true"
            android:icon="@mipmap/ic_kait_launcher"
            android:label="@string/group_modules"
            android:launchMode="singleTop"
            android:taskAffinity="org.yasvara.laras.kait"
            android:theme="@style/Theme.Laras" />
        <activity-alias
            android:name=".KaitLauncherAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_kait_launcher"
            android:label="@string/group_modules"
            android:targetActivity=".KaitActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Nada (Processor effects): standalone entry point for Homescreen pinned shortcuts and App Drawer icon (enabled by default for quick access). -->
        <activity
            android:name=".NadaActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode|assetsPaths"
            android:exported="true"
            android:icon="@mipmap/ic_nada_launcher"
            android:label="@string/nada_title"
            android:launchMode="singleTop"
            android:taskAffinity="org.yasvara.laras.nada"
            android:theme="@style/Theme.Laras" />
        <activity-alias
            android:name=".NadaLauncherAlias"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_nada_launcher"
            android:label="@string/nada_title"
            android:targetActivity=".NadaActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- App updates: system_server reports blocked / to-review updates. -->
        <receiver
            android:name=".data.updates.UpdateEventReceiver"
            android:exported="true"
            android:permission="yasvara.permission.MANAGE_UPDATE_POLICY">
            <intent-filter>
                <action android:name="org.yasvara.laras.action.UPDATE_EVENT" />
            </intent-filter>
        </receiver>
        <!-- Ketik: the crash guard undid a keyboard change. -->
        <receiver
            android:name=".data.ketik.KetikRevertReceiver"
            android:exported="true"
            android:permission="yasvara.permission.MANAGE_KETIK">
            <intent-filter>
                <action android:name="org.yasvara.laras.action.KETIK_REVERTED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".data.updates.UpdateActionReceiver"
            android:exported="false" />
        <activity
            android:name=".data.updates.AllowOnceActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- Akar: system_server reports an app the root daemon refused. -->
        <receiver
            android:name=".data.root.RootDeniedReceiver"
            android:exported="true"
            android:permission="yasvara.permission.MANAGE_ROOT">
            <intent-filter>
                <action android:name="org.yasvara.laras.action.ROOT_DENIED" />
            </intent-filter>
        </receiver>
        <service
            android:name=".data.root.RootFreezeTile"
            android:exported="true"
            android:icon="@drawable/ic_laras"
            android:label="@string/root_tile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Samar: tap turns the fake location on or off; long press opens its page. -->
        <service
            android:name=".samar.SamarTile"
            android:exported="true"
            android:icon="@drawable/ic_samar"
            android:label="@string/samar_tile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>
        <!-- Tempel: tap cycles active NFC card profile; long press opens Tempel manager. -->
        <service
            android:name=".tempel.TempelTile"
            android:exported="true"
            android:icon="@drawable/ic_tempel"
            android:label="@string/tempel_title"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- Tempel: on-demand ISO-DEP / Type-4A NDEF Host Card Emulation service. -->
        <service
            android:name=".tempel.TempelHostApduService"
            android:exported="true"
            android:permission="android.permission.BIND_NFC_SERVICE">
            <intent-filter>
                <action android:name="android.nfc.cardemulation.action.HOST_APDU_SERVICE" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.cardemulation.host_apdu_service"
                android:resource="@xml/tempel_apduservice" />
        </service>
        <!-- Tempel: on-demand FeliCa (NFC-F) Host Card Emulation service. -->
        <service
            android:name=".tempel.TempelHostNfcFService"
            android:exported="true"
            android:permission="android.permission.BIND_NFC_SERVICE">
            <intent-filter>
                <action android:name="android.nfc.cardemulation.action.HOST_NFCF_SERVICE" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.cardemulation.host_nfcf_service"
                android:resource="@xml/tempel_nfcfservice" />
        </service>
        <!-- Tempel: on-demand lockscreen Quick Access Wallet card carousel. -->
        <service
            android:name=".tempel.TempelWalletService"
            android:exported="true"
            android:icon="@drawable/ic_tempel"
            android:label="@string/tempel_title"
            android:permission="android.permission.BIND_QUICK_ACCESS_WALLET_SERVICE">
            <intent-filter>
                <action android:name="android.service.quickaccesswallet.QuickAccessWalletService" />
            </intent-filter>
            <meta-data
                android:name="android.quickaccesswallet"
                android:resource="@xml/tempel_wallet" />
        </service>
        <!-- Share a place from a maps app, or open a geo: link, to use it as the fake location. -->
        <activity
            android:name=".samar.SamarLinkActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:icon="@drawable/ic_samar"
            android:label="@string/samar_link_label"
            android:taskAffinity=""
            android:theme="@style/Theme.Laras.Translucent">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="geo" />
            </intent-filter>
        </activity>

        <activity
            android:name=".depth.DepthStudioActivity"
            android:configChanges="uiMode|assetsPaths"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Laras" />
        <!-- Refreshes the filter lists once a day. -->
        <service
            android:name=".data.saring.SaringUpdateJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- Builds depth for new lock wallpapers (§9 Q3). -->
        <service
            android:name=".depth.DepthBuildService"
            android:exported="false"
            android:foregroundServiceType="mediaProcessing" />
        <!-- Ephemeral foreground notification service mirroring live Pasang CoW OTA progress & ETA. -->
        <service
            android:name=".data.pasang.PasangInstallService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- SystemUI asks for a picture's depth: only it holds STATUS_BAR_SERVICE. -->
        <receiver
            android:name=".depth.DepthBuildService$BuildRequestReceiver"
            android:exported="true"
            android:permission="android.permission.STATUS_BAR_SERVICE">
            <intent-filter>
                <action android:name="org.yasvara.laras.depth.action.BUILD" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".depth.DepthBuildService$TurnOffReceiver"
            android:exported="false" />
    </application>
</manifest>
