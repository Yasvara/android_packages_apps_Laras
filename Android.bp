package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app {
    name: "Laras",
    // Sound effects live in Laras › Sound.
    overrides: [
        "AudioFX",
        "MusicFX",
    ],

    srcs: [
        "src/**/*.kt",
        // The control plane of the native root; the same file services.core compiles.
        ":yasvara-root-aidl",
        ":yasvara-ketik-aidl",
        ":yasvara-app-visibility-aidl",
        ":yasvara-lelap-aidl",
        ":yasvara-saring-aidl",
        ":yasvara-padat-aidl",
        ":yasvara-nada-aidl",
        ":yasvara-nada-client",
    ],
    resource_dirs: ["res"],
    // Depth Studio's segmentation models, memory-mapped, so stored uncompressed.
    asset_dirs: ["assets"],
    aaptflags: [
        "-0",
        ".tflite",
        "-0",
        ".bin",
    ],
    manifest: "AndroidManifest.xml",

    certificate: "platform",
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,
    privapp_allowlist: "org.yasvara.laras.xml",
    required: ["default-permissions_org.yasvara.laras"],

    optimize: {
        enabled: true,
        optimize: true,
        proguard_flags_files: ["proguard.flags"],
        shrink_resources: true,
    },

    static_libs: [
        "androidx.activity_activity-compose",
        "androidx.compose.animation_animation",
        "androidx.compose.foundation_foundation",
        "androidx.compose.material3_material3",
        "androidx.compose.material_material-icons-extended",
        "androidx.compose.runtime_runtime",
        "androidx.compose.ui_ui",
        "androidx.core_core-ktx",
        "androidx.graphics_graphics-shapes",
        "androidx.lifecycle_lifecycle-runtime-compose",
        "androidx.lifecycle_lifecycle-viewmodel-compose",
        "androidx.navigation3_navigation3-runtime",
        "androidx.navigation3_navigation3-ui",
        "kotlinx_coroutines_android",
        "org.lineageos.platform.internal",
        // The lock screen clock faces, drawn here exactly as SystemUI draws them.
        "SystemUIClocks-YasvaraLib",
        "SystemUIPluginLib",
        // Clock face layouts reference ConstraintLayout; list it so its R class is generated.
        "androidx-constraintlayout_constraintlayout",
        // Runs Depth Studio's EdgeTAM model; carries its own arm64 JNI library.
        "yasvara-litert",
        // Runs the depth build's ToonOut and ISNet on the CPU.
        "yasvara-onnxruntime",
        // The colour engine SystemUI applies with, so drafts resolve to the same colours.
        "YasvaraMonet",
        // The management binder of the ROM-native Kait hooking runtime (vendor/yasvara/kait).
        "yasvara-kait-ipc",
    ],
    use_embedded_native_libs: true,
    // The filter list compiler (vendor/yasvara/saring).
    jni_libs: ["libsaring_jni"],

    kotlincflags: ["-Xjvm-default=all"],
}

// Laras' pure data layer, compiled into its host tests (vendor/yasvara/tests/laras).
filegroup {
    name: "Laras-theme-srcs",
    srcs: [
        "src/org/yasvara/laras/data/Pref.kt",
        "src/org/yasvara/laras/data/theme/ThemeCommitter.kt",
    ],
    // Soong lets packages outside //vendor name only the whole of it.
    visibility: ["//vendor:__subpackages__"],
}

// Depth Studio's saved-project and build formats and the build's image maths,
// free of the model runtime, for host tests.
filegroup {
    name: "Laras-depth-srcs",
    srcs: [
        "src/org/yasvara/laras/depth/DepthBuild.kt",
        "src/org/yasvara/laras/depth/DepthProject.kt",
        "src/org/yasvara/laras/depth/Fingerprint.kt",
        "src/org/yasvara/laras/depth/Foreground.kt",
        "src/org/yasvara/laras/depth/Raster.kt",
        "src/org/yasvara/laras/depth/SelectionOp.kt",
    ],
    visibility: ["//vendor:__subpackages__"],
}

// Pre-grants POST_NOTIFICATIONS for the App updates notices.
prebuilt_etc {
    name: "default-permissions_org.yasvara.laras",
    src: "default-permissions_org.yasvara.laras.xml",
    filename: "default-permissions_org.yasvara.laras.xml",
    sub_dir: "default-permissions",
    system_ext_specific: true,
}
